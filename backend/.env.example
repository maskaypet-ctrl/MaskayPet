# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL / Supabase Database Connection
# Replace with your Supabase Transaction/Session pooler or direct connection string:
# e.g.: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mascotas_qr?sslmode=disable
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=5000

# Authentication & JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-this-in-production-at-least-32-chars-long!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Supabase Storage / Project (Optional for storage uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET_PETS=pet-photos
SUPABASE_STORAGE_BUCKET_DOCS=medical-documents

# App Host for Public QR Links
PUBLIC_APP_URL=http://localhost:3000
